# Database - PostgreSQL (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/motomind?schema=public"

# Optionnel : pour le script de migration SQLite → PostgreSQL (chemin vers le fichier SQLite)
# DATABASE_URL_SQLITE="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Resend (emails)
# IMPORTANT : avec RESEND_FROM_EMAIL sur ton domaine (ex. noreply@motomind.fr), le domaine
# doit être "Verified" dans le dashboard Resend + DNS (SPF/DKIM) chez OVH.
# Sinon l’API renvoie : "The associated domain with your API key is not verified..."
# En attendant : domaine vérifié OU clé API "full access" selon ton compte Resend.
# Test rapide sans domaine : RESEND_FROM_EMAIL="onboarding@resend.dev" (destinataires souvent limités au compte Resend — voir doc Resend).
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="MotoMind <noreply@motomind.fr>"
# Optionnel : boîte réelle (même domaine) — aide la délivrabilité (Gmail, iCloud…)
# RESEND_REPLY_TO="contact@motomind.fr"

# Admin - recevoir les signalements de problème par email (optionnel)
ADMIN_EMAIL="admin@yourdomain.com"

# Vercel Cron (protéger l'endpoint cron)
CRON_SECRET="your-cron-secret"
