# ---------------------------------------------------------------------------
# Copie ce fichier en `.env` et remplis les valeurs (ne commite jamais `.env`).
# ---------------------------------------------------------------------------

# --- Base PostgreSQL (obligatoire partout : local + Vercel) ---
# Schéma Prisma = postgresql uniquement (plus de SQLite file:./dev.db).
# Supabase : Projet → Connecter → ORM → Prisma → copie DATABASE_URL (pooler 6543).
# Si le mot de passe contient @ : # % etc., encode-le (URL-encode) dans l’URL.
DATABASE_URL="postgresql://postgres.VOTRE_REF:VOTRE_MDP@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Obligatoire (schéma Prisma `directUrl`) — même mot de passe, port 5432, sans pgbouncer
DIRECT_URL="postgresql://postgres.VOTRE_REF:VOTRE_MDP@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- NextAuth ---
# Local :
NEXTAUTH_URL="http://localhost:3002"
# Production (Vercel) : exactement ton domaine public, ex. https://motomind.fr
NEXTAUTH_SECRET="openssl rand -base64 32  # génère une valeur longue et garde-la stable"
# Si besoin sur Vercel : AUTH_TRUST_HOST=1 (souvent inutile car VERCEL=1 est déjà défini)

# --- Resend (emails : inscription, reset MDP, alertes) ---
# Sans RESEND_API_KEY, l’inscription échoue après création user (rollback) ou les mails ne partent pas.
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="MotoMind <noreply@motomind.fr>"
# RESEND_REPLY_TO="contact@motomind.fr"

# --- Factures (Premium) : obligatoire sur Vercel ---
# En local sans cette variable, les fichiers vont dans public/uploads/invoices/.
# Sur Vercel le disque est en lecture seule : crée un Blob Store (Storage → Create) puis
# lie-le au projet : la variable BLOB_READ_WRITE_TOKEN est injectée automatiquement.
# Si tu as nommé la variable autrement sur Vercel (ex. motomind_READ_WRITE_TOKEN), l’API
# l’accepte aussi. Valeur = token « Read/Write » du Blob Store.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Optionnel ---
ADMIN_EMAIL="admin@votredomaine.fr"
CRON_SECRET="secret-pour-proteger-les-routes-cron-vercel"

# ---------------------------------------------------------------------------
# À dupliquer sur Vercel → Project → Settings → Environment Variables (Production)
# ---------------------------------------------------------------------------
# DATABASE_URL          (pooler Supabase)
# DIRECT_URL            (connexion directe — obligatoire pour le build Prisma)
# NEXTAUTH_URL          https://motomind.fr  (ton domaine canonique)
# NEXTAUTH_SECRET       même valeur que en local ou une dédiée prod
# RESEND_API_KEY
# RESEND_FROM_EMAIL
# CRON_SECRET           (si tu utilises les crons vercel.json)
# BLOB_READ_WRITE_TOKEN (factures Premium — auto si Blob lié au projet Vercel)
# ADMIN_EMAIL           (optionnel)
