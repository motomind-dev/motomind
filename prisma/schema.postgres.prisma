// Prisma schema for PostgreSQL — use this after migration.
// Replace schema.prisma with this file and run: npx prisma migrate dev --name init_postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Enums -----

enum MaintenanceType {
  OIL_CHANGE      // was: vidange
  CHAIN           // was: chaine
  TIRES           // was: pneus
  BRAKES          // was: freins
  GENERAL_SERVICE // was: revision_generale
}

enum MaintenanceStatus {
  UPCOMING  // was: A_VENIR
  SOON      // was: proche
  OVERDUE   // was: en_retard
  COMPLETED // was: termine
}

enum ReminderType {
  DISTANCE // was: distance
  DATE     // was: date
}

// ----- Models -----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  motorcycles Motorcycle[]
  accounts    Account[]
  sessions    Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Motorcycle {
  id          String    @id @default(cuid())
  userId      String
  marque      String
  modele      String
  annee       Int
  kilometrage Int       @default(0)
  photo       String?
  dateAchat   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenances  Maintenance[]

  @@map("motorcycle")
}

model Maintenance {
  id                     String             @id @default(cuid())
  motorcycleId           String
  type                    MaintenanceType
  date                    DateTime
  kilometrage             Int
  note                    String?
  cout                    Float?
  statut                  MaintenanceStatus  @default(UPCOMING)
  garage                  String?
  reminderSent            Boolean            @default(false)
  nextDueMileage          Int?
  nextDueDate             DateTime?
  reminderMileageBefore   Int                @default(500)
  reminderDaysBefore     Int                @default(15)
  intervalleKm            Int?
  intervalleJours         Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  motorcycle Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  reminders   Reminder[]

  @@map("maintenance")
}

model Reminder {
  id            String       @id @default(cuid())
  maintenanceId String
  type          ReminderType
  dateEnvoi     DateTime
  envoye        Boolean      @default(false)
  createdAt     DateTime     @default(now())

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([dateEnvoi, envoye])
  @@map("reminder")
}
